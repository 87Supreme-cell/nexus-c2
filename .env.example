# Airgap / Local AI Configuration
OLLAMA_HOST=http://127.0.0.1:11434
DEFAULT_OLLAMA_MODEL=qwen2.5-coder:7b

# Antigravity Autonomous Agent Bridge
ANTIGRAVITY_BIN=/opt/homebrew/bin/agy
DEFAULT_WORKSPACE_DIR=/Users/symbrook

# Optional Google Cloud & Workspace OAuth (for live synchronization)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3030/api/auth/callback/google

# Optional Google Gemini Cloud API Key (if cloud egress is authorized)
GEMINI_API_KEY=

# Server Port
PORT=3030
